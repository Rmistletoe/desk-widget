<Window x:Class="DeskWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DeskWidget.ViewModels"
        mc:Ignorable="d"
        Title="桌面便签挂件"
        Icon="Assets/app.png"
        Width="310" Height="490"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="{Binding Config.AlwaysOnTop}"
        Opacity="{Binding Config.Opacity}"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <!-- 主容器 -->
    <Grid Margin="6">
        <!-- 窗口投影 -->
        <Grid.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.18" />
        </Grid.Effect>

        <!-- 胶囊收起态 -->
        <Border x:Name="CapsulePanel"
                CornerRadius="20"
                BorderBrush="#1A000000"
                BorderThickness="1"
                Background="{Binding NoteColor, Converter={StaticResource ColorToBrush}}"
                Height="42"
                VerticalAlignment="Top"
                MouseLeftButtonDown="OnWindowDragMove">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCapsuleMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/app.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CountdownText}" FontWeight="SemiBold" FontSize="12" Foreground="#374151" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#33F59E0B" CornerRadius="10" Padding="6,1" Margin="0,0,6,0">
                        <TextBlock Text="{Binding UncompletedTodoCount, StringFormat='{}{0} 项'}" 
                                   Foreground="#92400E" FontWeight="Bold" FontSize="10" />
                    </Border>
                    <Button Width="24" Height="24" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="双击展开便签"
                            Command="{Binding ToggleCapsuleCommand}">
                        <TextBlock Text="↗" FontSize="14" FontWeight="Bold" Foreground="#6B7280" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 完整便签展开面板 -->
        <Border x:Name="NormalPanel"
                CornerRadius="18"
                BorderBrush="#1A000000"
                BorderThickness="1"
                Background="{Binding NoteColor, Converter={StaticResource ColorToBrush}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCapsuleMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- 1. 顶部状态栏 -->
                    <RowDefinition Height="Auto" />
                    <!-- 2. 中间标签切换 -->
                    <RowDefinition Height="Auto" />
                    <!-- 3. 内容主体 -->
                    <RowDefinition Height="*" />
                    <!-- 4. 底部栏 -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ================= 1. 顶部状态栏 ================= -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#0D000000" Padding="12,10,12,8"
                        Background="Transparent"
                        MouseLeftButtonDown="OnWindowDragMove">
                    <StackPanel>
                        <!-- 顶层工具栏 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Logo 与发薪日状态胶囊 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="Assets/app.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Border CornerRadius="12" Background="#1AF59E0B" Padding="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💰 " FontSize="11" />
                                        <TextBlock Text="{Binding PaydayText}" FontWeight="Bold" FontSize="11" Foreground="#B45309" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 右侧按钮组 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- 设置按钮 -->
                                <Button Width="26" Height="26" Margin="2,0" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="打开挂件设置"
                                        Command="{Binding ToggleSettingsCommand}">
                                    <TextBlock Text="⚙️" FontSize="12" />
                                </Button>
                                <!-- 置顶状态切换 -->
                                <Button Width="26" Height="26" Margin="2,0" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="置顶窗口"
                                        Click="OnToggleAlwaysOnTopClick">
                                    <TextBlock Text="📌" FontSize="12" />
                                </Button>
                                <!-- 缩小为胶囊 -->
                                <Button Width="26" Height="26" Margin="2,0" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="收起为迷你胶囊"
                                        Command="{Binding ToggleCapsuleCommand}">
                                    <TextBlock Text="↗" FontSize="13" FontWeight="Bold" Foreground="#6B7280" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 下班倒计时与工时进度 -->
                        <Grid Margin="0,6,0,3">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="⏰ " FontSize="12" />
                                <TextBlock Text="{Binding CountdownText}" FontWeight="Bold" FontSize="12" Foreground="#374151" />
                            </StackPanel>
                            <TextBlock Text="{Binding WorkProgressPercent, StringFormat='已打工 {0}%'}" 
                                       HorizontalAlignment="Right" FontSize="11" Foreground="#9CA3AF" FontWeight="Medium" />
                        </Grid>

                        <!-- 进度条本体 -->
                        <ProgressBar Height="5" Value="{Binding WorkProgressPercent}" Maximum="100"
                                     Foreground="#10B981" Background="#15000000" BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- ================= 2. 中间标签切换 ================= -->
                <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="#0D000000" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="0,0,4,0" Height="28"
                                Click="OnSwitchToTodoClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝 待办清单 " FontSize="11" />
                                <Border Background="#33F59E0B" CornerRadius="8" Padding="5,0" Margin="2,0,0,0">
                                    <TextBlock Text="{Binding UncompletedTodoCount}" FontSize="9" FontWeight="Bold" Foreground="#92400E" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Margin="4,0,0,0" Height="28"
                                Click="OnSwitchToNoteClick">
                            <TextBlock Text="📌 随手便签" FontSize="11" />
                        </Button>
                    </Grid>
                </Border>

                <!-- ================= 3. 内容主体区域 ================= -->
                <Grid Grid.Row="2" Margin="10,8">
                    <!-- 3.1 待办清单视图 -->
                    <Grid x:Name="TodoViewPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 输入框 -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TodoInputBox"
                                     Text="{Binding NewTodoText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" FontSize="12"
                                     Background="#CCFFFFFF" BorderBrush="#20000000"
                                     KeyDown="OnTodoInputKeyDown" />
                            <Button Grid.Column="1" Margin="6,0,0,0" Width="36"
                                    Command="{Binding AddTodoCommand}">
                                <TextBlock Text="+" FontWeight="Bold" FontSize="14" />
                            </Button>
                        </Grid>

                        <!-- 速填推荐标签 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="速填: " FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Content="[重要]" Padding="4,1" Margin="2,0" FontSize="10" Click="OnQuickAddTagClick" />
                            <Button Content="[工作]" Padding="4,1" Margin="2,0" FontSize="10" Click="OnQuickAddTagClick" />
                            <Button Content="[生活]" Padding="4,1" Margin="2,0" FontSize="10" Click="OnQuickAddTagClick" />
                            <Button Content="[学习]" Padding="4,1" Margin="2,0" FontSize="10" Click="OnQuickAddTagClick" />
                        </StackPanel>

                        <!-- 待办条目列表 -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Todos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Background="#A0FFFFFF" BorderBrush="#0D000000" BorderThickness="1" 
                                                Margin="0,0,0,5" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 复选框 -->
                                                <CheckBox IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Margin="0,0,6,0" />

                                                <!-- 待办文字内容 -->
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" 
                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource StrikeThrough}}"
                                                           Foreground="{Binding IsCompleted, Converter={x:Null}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1F2937" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="#9CA3AF" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- 删除按钮 -->
                                                <Button Grid.Column="2" Content="✕" Width="18" Height="18" Padding="0"
                                                        FontSize="9" Background="Transparent" BorderThickness="0" Foreground="#EF4444"
                                                        Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 3.2 随手便签视图 -->
                    <Grid x:Name="NoteViewPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 5色莫兰迪色彩选择栏 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Center">
                            <Button Width="20" Height="20" Margin="4,0" Background="#FFF8E1" BorderBrush="#D1D5DB" 
                                    Command="{Binding SetNoteColorCommand}" CommandParameter="yellow" ToolTip="暖阳杏黄" />
                            <Button Width="20" Height="20" Margin="4,0" Background="#E8F5E9" BorderBrush="#D1D5DB" 
                                    Command="{Binding SetNoteColorCommand}" CommandParameter="green" ToolTip="薄荷清绿" />
                            <Button Width="20" Height="20" Margin="4,0" Background="#FCE4EC" BorderBrush="#D1D5DB" 
                                    Command="{Binding SetNoteColorCommand}" CommandParameter="pink" ToolTip="早樱柔粉" />
                            <Button Width="20" Height="20" Margin="4,0" Background="#E1F5FE" BorderBrush="#D1D5DB" 
                                    Command="{Binding SetNoteColorCommand}" CommandParameter="blue" ToolTip="晴空淡蓝" />
                            <Button Width="20" Height="20" Margin="4,0" Background="#F5F5F7" BorderBrush="#D1D5DB" 
                                    Command="{Binding SetNoteColorCommand}" CommandParameter="white" ToolTip="极简冷白" />
                        </StackPanel>

                        <!-- 便签编辑框（打字实时保存） -->
                        <TextBox Grid.Row="1"
                                 Text="{Binding NoteContent, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Background="#80FFFFFF" BorderBrush="#15000000"
                                 Padding="8" FontSize="12"
                                 TextChanged="OnNoteTextChanged" />
                    </Grid>
                </Grid>

                <!-- ================= 4. 底部栏 ================= -->
                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="#0D000000" Padding="12,6">
                    <Grid>
                        <TextBlock Text="{Binding CurrentGreeting}" 
                                   FontSize="11" Foreground="#4B5563"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        <TextBlock Text="桌面便签 v0.2" 
                                   HorizontalAlignment="Right" FontSize="9" Foreground="#9CA3AF" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ================= 5. 设置弹窗遮罩层 ================= -->
                <Grid Grid.RowSpan="4" Background="#50000000"
                      Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="12" Background="#FAFFFFFF" Width="280" Margin="15"
                            VerticalAlignment="Center" Padding="14" BorderBrush="#20000000" BorderThickness="1">
                        <StackPanel>
                            <!-- 标题与关闭 -->
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="⚙️ 挂件设置" FontWeight="Bold" FontSize="13" Foreground="#1F2937" VerticalAlignment="Center" />
                                <Button Content="✕" Width="20" Height="20" HorizontalAlignment="Right"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding ToggleSettingsCommand}" />
                            </Grid>

                            <!-- 作息时间 -->
                            <TextBlock Text="⏰ 作息时间设置 (HH:mm)" FontSize="11" Foreground="#4B5563" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,4,0" Text="{Binding Config.WorkStartTime, UpdateSourceTrigger=PropertyChanged}" FontSize="12" />
                                <TextBox Grid.Column="1" Margin="4,0,0,0" Text="{Binding Config.WorkEndTime, UpdateSourceTrigger=PropertyChanged}" FontSize="12" />
                            </Grid>

                            <!-- 发薪日 -->
                            <TextBlock Text="💰 每月发薪日 (1~31)" FontSize="11" Foreground="#4B5563" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Config.Payday, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Margin="0,0,0,8" />

                            <!-- 窗口外观 -->
                            <CheckBox Content="窗口总是置顶" IsChecked="{Binding Config.AlwaysOnTop}" Margin="0,0,0,8" FontSize="11" />

                            <TextBlock Text="{Binding Config.Opacity, StringFormat='窗口不透明度: {0:P0}'}" FontSize="11" Foreground="#4B5563" Margin="0,0,0,2" />
                            <Slider Minimum="0.6" Maximum="1.0" Value="{Binding Config.Opacity}" Margin="0,0,0,10" />

                            <!-- 自定义寄语 -->
                            <TextBlock Text="💌 专属励志/暖心寄语" FontSize="11" Foreground="#4B5563" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Config.CustomMessage, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Margin="0,0,0,12" />

                            <!-- 保存按钮（显式持久化！） -->
                            <Button Content="保存并关闭" FontWeight="Bold" Height="30"
                                    Background="#F59E0B" Foreground="White" BorderThickness="0"
                                    Command="{Binding SaveSettingsCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
